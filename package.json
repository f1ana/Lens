{
  "name": "lens",
  "private": true,
  "version": "0.0.0",
  "description": "A spoiler log viewer for the Ship of Harkinian, 2 Ship 2 Harkinian and Lighthouse randomizers",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f1ana/Lens.git"
  },
  "homepage": "https://github.com/f1ana/Lens#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "cycles": "dpdm --no-warning --no-tree --transform --tsconfig tsconfig.app.json --exit-code circular:1 src/main.tsx",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "generate:data": "tsx scripts/ship/generate-data.ts",
    "generate:releases": "tsx scripts/ship/generate-releases.ts",
    "generate:2ship-data": "tsx scripts/2ship/generate-data.ts",
    "generate:2ship-releases": "tsx scripts/2ship/generate-releases.ts",
    "generate:lighthouse-data": "tsx scripts/lighthouse/generate-data.ts",
    "generate:lighthouse-releases": "tsx scripts/lighthouse/generate-releases.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "dpdm": "^4.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.1.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
